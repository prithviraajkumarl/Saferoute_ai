# Environment Configuration for SafeRoute AI
PROJECT_NAME="SafeRoute AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database (Default local SQLite or PostgreSQL in Docker)
DATABASE_URL="sqlite:///./saferoute.db"
# DATABASE_URL="postgresql+psycopg2://saferoute_user:saferoute_secure_password_2026@localhost:5432/saferoute_db"

# Redis
REDIS_URL="redis://localhost:6379/0"
CACHE_EXPIRATION_SECONDS=600

# Security (JWT HS256)
SECRET_KEY="saferoute-super-secret-tactical-production-key-2026-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Provider Endpoints
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OSRM_BASE_URL="https://router.project-osrm.org"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NDMA_SACHET_ENDPOINT="https://sachet.ndma.gov.in/cap_api"

# Default Geographic Centroid (Chennai Coastal Belt)
DEFAULT_LAT=13.0827
DEFAULT_LNG=80.2707

# Risk Engine
RISK_ENGINE_VERSION="2.1.0"
HAZARD_BUFFER_METERS=1200.0
STALE_HAZARD_HOURS=24
